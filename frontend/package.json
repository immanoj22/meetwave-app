{
  "name": "meetwave",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "cc": "rimraf node_modules/.cache/babel-loader/*",
    "android": "cd android && react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "clean": "cd android && ./gradlew clean -x externalNativeBuildCleanDebug -x externalNativeBuildCleanRelease",
    "import-font": "npx react-native-asset",
    "postjpx": "npx jetify",
    "apkrelease": "cd android && ./gradlew assembleRelease",
    "start:demo": "npm run cc && gulp set --env=demo && npx react-native start --port=8081",
    "start:client": "npm run cc && gulp set --env=client && npx react-native start --port=8081",
    "bundle": "npm run cc && gulp set --env=demo && npm run clean &&  cd android && ./gradlew bundleRelease",
    "bundle_client": "npm run cc && gulp set --env=client && npm run clean &&  cd android && ./gradlew bundleRelease",
    "debugApk": "npm run cc && gulp set --env=demo && npm run clean && cd android && ./gradlew assembleDebug",
    "postinstall": "patch-package",
    "reinstall": "rm -rf package-lock.json node_modules && npm install",
    "cmake": "rm -rf android/app/build/ android/app/.cxx/",
    "releaseclient": "npm run cc && gulp set --env=client && rm -rf ./android/app/src/main/res/drawable-* \n  rm -rf ./android/app/src/main/res/raw \n cd android \n ./gradlew clean \n ./gradlew assembleRelease"
  },
  "overrides": {
    "cross-spawn": "^6.0.6",
    "react-native-worklets": "^0.8.1",
    "react-native-nitro-modules": "^0.35.0"
  },
